root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
# Markdown usa trailing spaces para <br> — no recortar
trim_trailing_whitespace = false
max_line_length = off

[*.yml]
indent_size = 2

[*.toml]
indent_size = 4

[Makefile]
indent_style = tab
